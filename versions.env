UV_AMD64_SHA256=600cf9a742aca00d292673b16b5acffaa7b8c269a364ad0c2e79498dcb1fe101

# Frozen Posit Public Package Manager snapshot used for R package resolution/restores.
# 2026-08-11 is the last completed business-day snapshot before this repository revision.
# Update this date intentionally before regenerating renv.lock.
R_PPM_SNAPSHOT=2026-08-11
R_PPM_CRAN_URL=https://packagemanager.posit.co/cran/__linux__/noble/${R_PPM_SNAPSHOT}
R_PPM_BIOC_MIRROR=https://packagemanager.posit.co/bioconductor/${R_PPM_SNAPSHOT}

# RStudio Server Open Source, embedded in the final SIF.
RSTUDIO_SERVER_VERSION=2026.07.1-147

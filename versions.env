HEADLESS_BASE_DIGEST=sha256:8c6bcd19aae3490ebe75f7d06842f4046dc2ce23822d74eac450844af826e108
RSTUDIO_BASE_IMAGE=docker.io/rocker/rstudio@sha256:4537a8727031ab76d6fd27c2223fb68fc2e7b7ae00071b334b84ed9fff7297cd

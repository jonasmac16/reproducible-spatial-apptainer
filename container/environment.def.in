Bootstrap: docker
From: @BASE_IMAGE@

%labels
  org.opencontainers.image.title "Reproducible scientific R/Python environment"
  org.opencontainers.image.description "Profile-driven Apptainer environment with optional RStudio Server"
  org.opencontainers.image.base.digest "@BASE_DIGEST@"
  io.repro.profile "@PROFILE@"
  io.repro.build.mode "@BUILD_MODE@"
  io.repro.r.version "4.6.1"
  io.repro.python.version "3.13.15"
  io.repro.bioconductor.version "3.23"
  io.repro.rstudio.enabled "@RSTUDIO_ENABLED@"

%files
  versions.env /opt/project/versions.env
  env /opt/project/env
  container/scripts /opt/project/build-scripts
  container/rstudio/defaults /opt/rstudio-defaults
  container/rstudio/start-server.sh /opt/rstudio/start-server.sh
  container/rstudio/rsession.sh /opt/rstudio/rsession.sh
  container/rstudio/validate.sh /opt/rstudio/validate.sh

%post
  set -eux
  set -a
  . /opt/project/versions.env
  set +a
  export LANG=C.UTF-8 LC_ALL=C.UTF-8
  export TMPDIR=/var/tmp/project-build
  export UV_CACHE_DIR="$TMPDIR/uv-cache"
  export RSTUDIO_ENABLED="@RSTUDIO_ENABLED@"
  mkdir -p "$TMPDIR" "$UV_CACHE_DIR" /opt/project/R/library /opt/project/python /opt/provenance
  chmod +x /opt/project/build-scripts/*.sh /opt/rstudio/*.sh
  {
    echo "PROFILE=@PROFILE@"
    echo "BUILD_MODE=@BUILD_MODE@"
    echo "RSTUDIO_ENABLED=$RSTUDIO_ENABLED"
    echo "BUILD_DATE_UTC=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "SOURCE_COMMIT=recorded-by-release-manifest"
  } > /opt/provenance/build-info.env

  /opt/project/build-scripts/install-system.sh
  /opt/project/build-scripts/install-tools.sh

  export PATH=/opt/project/python/bin:/usr/local/bin:$PATH
  export R_LIBS_SITE=/opt/project/R/library:/opt/R/tooling:/usr/local/lib/R/site-library:/usr/local/lib/R/library:/usr/lib/R/library
  export BIOCONDUCTOR_VERSION=3.23

  py_lock=0; r_lock=0
  test -s /opt/project/env/python/uv.lock && py_lock=1 || true
  test -s /opt/project/env/R/renv.lock && r_lock=1 || true
  if [ "$py_lock" -ne "$r_lock" ]; then
    echo "ERROR: uv.lock and renv.lock must both be present or both absent" >&2
    exit 40
  fi
  if [ "$py_lock" -eq 1 ]; then
    mode=locked
  else
    mode=resolve
    rm -f /opt/project/env/python/uv.lock /opt/project/env/R/renv.lock
  fi
  printf '%s\n' "$mode" > /opt/provenance/build-mode.txt

  /opt/project/build-scripts/install-python.sh
  Rscript /opt/project/build-scripts/install-r.R "$mode"
  test -s /opt/project/env/python/uv.lock
  test -s /opt/project/env/R/renv.lock

  if [ "$RSTUDIO_ENABLED" = 1 ]; then
    /usr/lib/rstudio-server/bin/rserver --check-config
  fi
  /opt/project/build-scripts/validate.sh

  cp /opt/project/build-scripts/provenance.sh /usr/local/bin/environment-provenance
  cp /opt/project/build-scripts/validate.sh /usr/local/bin/environment-validate
  chmod +x /usr/local/bin/environment-provenance /usr/local/bin/environment-validate

  dpkg-query -W -f='${Package}\t${Version}\n' | sort > /opt/provenance/dpkg-installed.tsv
  R_LIBS_SITE=/opt/project/R/library:/opt/R/tooling:/usr/local/lib/R/library \
    Rscript -e 'x <- as.data.frame(installed.packages()[,c("Package","Version"),drop=FALSE]); write.table(x, "/opt/provenance/R-packages.tsv", sep="\t", row.names=FALSE, quote=FALSE)'
  uv pip list --python /opt/project/python/bin/python --format freeze | sort > /opt/provenance/python-packages.txt
  sha256sum /opt/project/env/python/uv.lock /opt/project/env/R/renv.lock > /opt/provenance/lockfiles.sha256

  uv cache clean || true
  rm -rf /var/lib/apt/lists/* /root/.cache "$TMPDIR" /var/tmp/tool-install

%environment
  export RSTUDIO_ENABLED="@RSTUDIO_ENABLED@"
  export BUILD_MODE="@BUILD_MODE@"
  export ENVIRONMENT_PROFILE="@PROFILE@"
  export PATH=/opt/project/python/bin:/usr/local/bin:$PATH
  export VIRTUAL_ENV=/opt/project/python
  export RETICULATE_PYTHON=/opt/project/python/bin/python
  export R_LIBS_SITE=/opt/project/R/library:/opt/R/tooling:/usr/local/lib/R/site-library:/usr/local/lib/R/library:/usr/lib/R/library
  export RENV_CONFIG_AUTOLOADER_ENABLED=FALSE
  export RENV_AUTOLOAD_ENABLED=FALSE
  export PYTHONNOUSERSITE=1
  export PYTHONDONTWRITEBYTECODE=1
  export UV_CACHE_DIR="/tmp/uv-cache-$(id -u)"
  export XDG_CACHE_HOME="/tmp/xdg-cache-$(id -u)"
  export MPLCONFIGDIR="/tmp/matplotlib-$(id -u)"
  export NUMBA_CACHE_DIR="/tmp/numba-$(id -u)"
  export LANG=C.UTF-8
  export LC_ALL=C.UTF-8

%test
  set -eu
  export HOME="/tmp/test-home-$(id -u)"
  export TMPDIR="/tmp/test-tmp-$(id -u)"
  mkdir -p "$HOME" "$TMPDIR" "$UV_CACHE_DIR" "$XDG_CACHE_HOME" "$MPLCONFIGDIR" "$NUMBA_CACHE_DIR"
  environment-validate

%runscript
  if [ "$#" -eq 0 ]; then exec /bin/bash; fi
  exec "$@"

%help
  Profile-driven scientific environment.
  Build mode: @BUILD_MODE@. Profile: @PROFILE@.
  Runtime dependencies are embedded in /opt/project/R/library and /opt/project/python.

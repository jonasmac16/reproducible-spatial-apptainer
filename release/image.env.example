# Commit a populated copy as release/image.env with a manuscript/release.
IMAGE_FILE=project-manuscript-v1.sif
IMAGE_SHA256=REPLACE_WITH_SHA256
# Prefer an immutable artifact/digest URI when using an OCI registry.
IMAGE_ORAS=oras://ghcr.io/ORG/PROJECT@sha256:REPLACE_WITH_REGISTRY_DIGEST
# Or use a durable HTTPS artifact (Zenodo, institutional repository, GitHub Release).
IMAGE_URL=
